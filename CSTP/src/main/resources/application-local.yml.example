# ============================================
# 本地配置模板（本文件会提交到 Git，供他人克隆后参考）
# 使用方法：
#   1. 复制本文件，重命名为 application-local.yml（去掉 .example 后缀）
#   2. 把里面的值改成你自己的本地配置
#   3. application-local.yml 已被 .gitignore 忽略，不会被提交
# ============================================
spring:
  datasource:
    password: 你的数据库密码
  # data:
  #   redis:
  #     password: 你的Redis密码
