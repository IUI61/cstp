<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.cstp.mapper.MessageMapper">
    <select id="getMessagesList" resultType="org.example.cstp.vo.MessagesListVo">
        SELECT id,sender_id,content FROM message WHERE conversation_id = #{conversationId} ORDER BY create_time DESC
    </select>
</mapper>
